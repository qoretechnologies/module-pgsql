#!/usr/bin/env qore
# Copyright 2026 Qore Technologies, s.r.o.
%modern
%requires QUnit
%requires Util
%prepend-module-path "${SCRIPT_DIR}/../build"
%requires pgsql
%exec-class SessionTimeZoneTest

# The "timezone" option declares the zone in which the driver writes and reads plain timestamps; without it, that is
# the zone of the Program that opens the connection.  The session must use the same zone, whatever the server's zone
# is, on every connection and after every reconnect.
class SessionTimeZoneTest inherits Test {
    private {
        # candidate zones: the first whose UTC offset differs from the server session's is used
        const Regions = ("Asia/Kathmandu", "America/Caracas");
        const Offsets = ("+05:45", "-03:30");

        # plain timestamps written and read back; the first one does not exist in Central European time
        const Stamps = (2026-03-29T02:30:00, 2026-10-25T02:30:00.123456, 2026-01-01T00:00:00, 2026-07-01T23:59:59);

        string server_zone;
        int server_offset;
    }

    constructor() : Test("PostgreSQL session time zone", "1.0", \ARGV) {
        addTestCase("a region name sets the session zone", \regionZone());
        addTestCase("a UTC offset sets the session zone with its sign", \offsetZone());
        addTestCase("the session zone is restored after a lost connection", \reconnect());
        addTestCase("the client encoding is restored after a lost connection", \encodingReconnect());
        addTestCase("every pooled connection uses the declared zone", \pool());
        addTestCase("changing the option on an open connection changes the session zone", \changeOpen());
        addTestCase("a rolled back transaction does not revert the declared zone", \rollbackKeepsZone());
        addTestCase("without the option the session uses the Program's zone", \programZone());
        addTestCase("a zone loaded from a file is set by its region name", \fileZone());
        addTestCase("a zone without a region name keeps the session's zone", \unnamedZone());
        addTestCase("a connection's configuration opens a copy in the same zone", \configCopy());
        addTestCase("invalid zones are rejected with a clear error", \invalidZones());
        addTestCase("COPY dates agree with bound inserts in the datasource zone", \copyDates());
        set_return_value(main());
    }

    private Datasource plain() {
        if (!ENV.QORE_DB_CONNSTR_PGSQL) {
            testSkip("set QORE_DB_CONNSTR_PGSQL to a disposable PostgreSQL database");
        }
        return new Datasource(ENV.QORE_DB_CONNSTR_PGSQL);
    }

    private Datasource withZone(string zone) {
        Datasource ds = plain();
        ds.setOption("timezone", zone);
        ds.open();
        return ds;
    }

    # returns the zone that a session starts with (the server's, or the client's PGTZ), which the driver replaces
    # with the connection's zone, and its current UTC offset in seconds east
    private serverZone() {
        if (server_zone) {
            return;
        }
        Datasource ds = plain(); on_exit ds.close();
        hash<auto> row = ds.selectRow("select reset_val as zone, extract(epoch from (now() at time zone reset_val) "
            "- (now() at time zone 'UTC'))::int as offset from pg_catalog.pg_settings where name = 'TimeZone'");
        server_zone = row.zone;
        server_offset = row.offset;
        ds.rollback();
    }

    # returns the current UTC offset in seconds east of a region name or of a UTC offset ("+HH:MM" or "-HHMM")
    private static int utcOffset(string zone) {
        *list<*string> m = (zone =~ x/^([-+])([0-9]{2}):?([0-9]{2})$/);
        if (m) {
            int secs = m[1].toInt() * 3600 + m[2].toInt() * 60;
            return m[0] == "-" ? -secs : secs;
        }
        return new TimeZone(zone).UTCOffset();
    }

    # returns the first zone whose offset differs from the server session's
    private string differentZone(list<string> zones) {
        serverZone();
        foreach string zone in (zones) {
            if (utcOffset(zone) != server_offset) {
                return zone;
            }
        }
        throw "TEST-SETUP-ERROR", sprintf("no candidate zone in %y differs from the server's", zones);
    }

    # verifies that the session uses the declared zone: plain timestamps round-trip exactly, and server-side
    # date/time functions use the declared zone
    private checkSession(Datasource ds, string zone) {
        ds.exec("create temporary table session_tz_check (id int, ts timestamp, created timestamp default now()) "
            "on commit drop");
        foreach date stamp in (Stamps) {
            ds.exec("insert into session_tz_check (id, ts) values (%v, %v)", $#, stamp);
        }
        list<auto> rows = ds.select("select ts from session_tz_check order by id").ts;
        assertEq(Stamps, rows, zone + ": plain timestamps");
        hash<auto> row = ds.selectRow("select now() as now, now()::timestamp as local, current_date as today, "
            "to_char(now(), 'YYYY-MM-DD HH24:MI:SS') as text, "
            "(select created from session_tz_check limit 1) as created");
        # the plain timestamp of the current instant read in the declared zone is that instant
        assertEq(row.now, row.local, zone + ": now()::timestamp");
        assertEq(row.now, row.created, zone + ": DEFAULT now()");
        assertEq(row.now.format("YYYY-MM-DD HH:mm:SS"), row.text, zone + ": to_char()");
        assertEq(row.now.format("YYYY-MM-DD"), row.today.format("YYYY-MM-DD"), zone + ": current_date");
        ds.commit();
    }

    private regionZone() {
        string zone = differentZone(Regions);
        Datasource ds = withZone(zone); on_exit ds.close();
        assertEq(zone, ds.getOption("timezone"));
        assertEq(zone, ds.selectRow("select pg_catalog.current_setting('TimeZone') as zone").zone);
        ds.commit();
        checkSession(ds, zone);
    }

    private offsetZone() {
        string zone = differentZone(Offsets);
        Datasource ds = withZone(zone); on_exit ds.close();
        # an offset east of UTC is a positive extract(timezone)
        assertEq(utcOffset(zone),
            ds.selectRow("select extract(timezone from now())::int as offset").offset);
        ds.commit();
        checkSession(ds, zone);
        # "+00:00" is UTC
        Datasource utc = withZone("+00:00"); on_exit utc.close();
        assertEq(0, utc.selectRow("select extract(timezone from now())::int as offset").offset);
        utc.commit();
        checkSession(utc, "UTC");
    }

    private reconnect() {
        string zone = differentZone(Regions);
        Datasource ds = withZone(zone); on_exit ds.close();
        int pid = ds.selectRow("select pg_catalog.pg_backend_pid() as pid").pid;
        ds.commit();
        terminate(pid);
        # no transaction is in progress, so the driver reconnects and runs the statement again
        hash<auto> row = ds.selectRow("select pg_catalog.pg_backend_pid() as pid, "
            "pg_catalog.current_setting('TimeZone') as zone");
        assertNeq(pid, row.pid, "the connection was reestablished");
        assertEq(zone, row.zone);
        ds.commit();
        checkSession(ds, zone);
    }

    # terminates a backend from another connection and waits for it to exit
    private terminate(int pid) {
        Datasource admin = plain(); on_exit admin.close();
        # with a timeout, pg_terminate_backend() returns once the backend has exited
        assertTrue(admin.selectRow("select pg_catalog.pg_terminate_backend(%v, 60000) as done", pid).done);
        admin.commit();
    }

    private encodingReconnect() {
        plain();
        # a client encoding that differs from the database's (UTF8 for a default test database)
        hash<auto> config = parse_datasource(ENV.QORE_DB_CONNSTR_PGSQL);
        config.charset = "latin1";
        Datasource ds(config); on_exit ds.close();
        ds.open();
        string text = "Ünïcödé àéîõü";
        hash<auto> row = ds.selectRow("select pg_catalog.pg_backend_pid() as pid, "
            "pg_catalog.current_setting('client_encoding') as enc, %v::text as str", text);
        assertEq("LATIN1", row.enc, "before the reconnect");
        assertEq(text, row.str, "before the reconnect");
        int pid = row.pid;
        ds.commit();
        terminate(pid);
        # no transaction is in progress, so the driver reconnects and runs the statement again
        row = ds.selectRow("select pg_catalog.pg_backend_pid() as pid, "
            "pg_catalog.current_setting('client_encoding') as enc, %v::text as str", text);
        assertNeq(pid, row.pid, "the connection was reestablished");
        assertEq("LATIN1", row.enc, "after the reconnect");
        assertEq("ISO-8859-1", row.str.encoding());
        assertEq(text, row.str, "after the reconnect");
        ds.commit();
    }

    private pool() {
        string zone = differentZone(Offsets);
        plain();
        DatasourcePool pool(ENV.QORE_DB_CONNSTR_PGSQL + "{min=2,max=2,timezone=" + zone + "}");
        # hold two connections at once so both pooled connections are checked
        Counter ready(2);
        Counter done(1);
        list<auto> zones = ();
        Mutex m();
        code check = sub () {
            on_exit pool.commit();
            int offset = pool.selectRow("select extract(timezone from now())::int as offset").offset;
            m.lock(); zones += offset; m.unlock();
            ready.dec();
            done.waitForZero();
        };
        background check();
        background check();
        ready.waitForZero();
        done.dec();
        int expected = utcOffset(zone);
        assertEq((expected, expected), zones);
    }

    private changeOpen() {
        string zone = differentZone(Regions);
        Datasource ds = plain(); on_exit ds.close();
        ds.open();
        ds.setOption("timezone", zone);
        assertEq(zone, ds.selectRow("select pg_catalog.current_setting('TimeZone') as zone").zone);
        ds.commit();
        checkSession(ds, zone);
        string offset = differentZone(Offsets);
        ds.setOption("timezone", offset);
        assertEq(utcOffset(offset),
            ds.selectRow("select extract(timezone from now())::int as offset").offset);
        ds.commit();
        checkSession(ds, offset);
    }

    private rollbackKeepsZone() {
        string zone = differentZone(Regions);
        Datasource ds = plain(); on_exit ds.close();
        ds.beginTransaction();
        ds.exec("create temporary table session_tz_rollback (id int) on commit drop");
        ds.setOption("timezone", zone);
        assertEq(zone, ds.selectRow("select pg_catalog.current_setting('TimeZone') as zone").zone);
        ds.rollback();
        # PostgreSQL reverts a SET made in a transaction that is rolled back; the declared zone must remain
        assertEq(zone, ds.selectRow("select pg_catalog.current_setting('TimeZone') as zone").zone);
        ds.commit();
        checkSession(ds, zone);
    }

    private programZone() {
        # a Program zone whose offset differs from the session's start zone, so that a session that kept the start
        # zone would show
        string zone = differentZone(Regions);
        TimeZone orig = TimeZone::get();
        on_exit TimeZone::set(orig);
        TimeZone::setRegion(zone);

        Datasource ds = plain(); on_exit ds.close();
        assertEq(zone, ds.selectRow("select pg_catalog.current_setting('TimeZone') as zone").zone);
        assertEq(zone, ds.getOption("timezone"));
        # a DATE keeps the calendar date of a value in the Program's zone
        ds.exec("create temporary table program_zone_check (d date) on commit drop");
        date midnight = date("2040-01-05T00:00:00");
        ds.exec("insert into program_zone_check values (%v)", midnight);
        assertEq("2040-01-05", ds.selectRow("select d::text as d from program_zone_check").d);
        ds.commit();
        checkSession(ds, zone);
    }

    # returns the TimeZone setting of a session opened by a qore process with the given TZ environment variable
    private string childSessionZone(string tz) {
        return childRun(tz, "Datasource ds(ENV.QORE_DB_CONNSTR_PGSQL);\n"
            "print(ds.selectRow(\"select pg_catalog.current_setting('TimeZone') as zone\").zone);\n");
    }

    #! Runs a script in a process whose local zone is @p tz and returns its output
    private string childRun(string tz, string code) {
        string script = tmp_location() + DirSep + get_random_string() + ".q";
        File f();
        f.open2(script, O_CREAT | O_WRONLY | O_TRUNC);
        f.write("%modern\n%requires pgsql\n" + code);
        f.close();
        on_exit unlink(script);
        string cmd = sprintf("TZ='%s' QORE_MODULE_DIR='%s/../build:%s' qore '%s' 2>&1", tz, get_script_dir(),
            ENV.QORE_MODULE_DIR ?? "", script);
        return backquote(cmd);
    }

    private fileZone() {
        plain();
        # the system's local zone file, when it is a link into a zoneinfo directory
        if (!is_link("/etc/localtime")) {
            testSkip("/etc/localtime is not a link");
        }
        *string region = (realpath("/etc/localtime") =~ x/\/zoneinfo\/(.+)$/)[0];
        if (!region) {
            testSkip("/etc/localtime is not in a zoneinfo directory");
        }
        assertEq(region, childSessionZone(":/etc/localtime"));
    }

    private unnamedZone() {
        serverZone();
        # a zone file outside of any zoneinfo directory has no region name that the server knows
        string dir = tmp_location() + DirSep + get_random_string();
        mkdir(dir);
        on_exit rmdir(dir);
        string zone_file = dir + DirSep + "Zone";
        File src();
        src.open2("/usr/share/zoneinfo/" + differentZone(Regions));
        File dst();
        dst.open2(zone_file, O_CREAT | O_WRONLY | O_TRUNC);
        dst.write(src.readBinary(-1));
        dst.close();
        on_exit unlink(zone_file);
        # the session keeps the zone it started with
        assertEq(server_zone, childSessionZone(":" + zone_file));
    }

    # a pool or a copy of a connection is opened from the connection's configuration, which reports its zone
    private configCopy() {
        serverZone();
        string region = differentZone(Regions);
        Datasource ds = withZone(region); on_exit ds.close();
        assertEq(region, ds.getConfigHash().options.timezone, "a declared zone is reported as declared");
        ds.rollback();
        # a zone file outside of any zoneinfo directory: its name, a path, is no zone the option accepts
        string dir = tmp_location() + DirSep + get_random_string();
        mkdir(dir);
        on_exit rmdir(dir);
        string zone_file = dir + DirSep + "Zone";
        File src();
        src.open2("/usr/share/zoneinfo/" + region);
        File dst();
        dst.open2(zone_file, O_CREAT | O_WRONLY | O_TRUNC);
        dst.write(src.readBinary(-1));
        dst.close();
        on_exit unlink(zone_file);
        string out = childRun(":" + zone_file, "Datasource ds(ENV.QORE_DB_CONNSTR_PGSQL);\nds.open();\n"
            "hash<auto> config = ds.getConfigHash();\n"
            "Datasource copy(config);\n"
            "printf(\"%s|%s|%s\\n\", config.options.timezone ?? \"none\", "
            "ds.selectRow(\"select pg_catalog.current_setting('TimeZone') as zone\").zone, "
            "copy.selectRow(\"select pg_catalog.current_setting('TimeZone') as zone\").zone);\n");
        assertEq(sprintf("none|%s|%s\n", server_zone, server_zone), out,
            "the copy opens and keeps the session's zone");
    }

    private copyDates() {
        list<*date> stamps = (date("2026-01-01T00:00:00Z"), date("2026-07-01T00:00:00Z"),
            date("2026-03-29T01:30:00.123456Z"), date("2026-10-25T01:30:00.654321Z"),
            date("2026-07-01T00:00:00+05:45"), NOTHING);
        list<*date> durations = (2D + 3h + 4m, 6M + 3D + 5us, -2D - 3h - 4m, 0s, 1s + 123456us, NOTHING);
        foreach string zone in (("UTC", "Europe/Prague", "Asia/Kathmandu", "-03:30")) {
            Datasource ds = withZone(zone); on_exit ds.close();
            ds.exec("create temporary table copy_zone_check (id int, ts timestamp(6), tz timestamptz(6), "
                "d date, duration interval) on commit drop");
            hash<auto> data = {"id": (), "ts": stamps, "tz": stamps, "d": stamps, "duration": durations};
            foreach *date stamp in (stamps) {
                push data.id, $#;
                ds.exec("insert into copy_zone_check values (%v, %v, %v, %v, %v)", $#, stamp, stamp, stamp,
                    durations[$#]);
            }
            # Compare stored wall times as well as instants; a repeated DST hour is deliberately included.
            string query = "select id, ts::text as ts, tz, d::text as d, duration from copy_zone_check order by id";
            hash<auto> expected = ds.select(query);
            foreach string mode in (("copy", "native")) {
                ds.exec("delete from copy_zone_check");
                if (mode == "copy") {
                    assertEq(stamps.size(), ds.exec("COPY copy_zone_check (id, ts, tz, d, duration) FROM STDIN", data));
                } else {
                    assertTrue(ds.bulkLoadBegin("copy_zone_check", ("id", "ts", "tz", "d", "duration"), NOTHING));
                    ds.bulkLoadRows(data);
                    ds.bulkLoadEnd(True);
                }
                assertEq(expected, ds.select(query), zone + ": " + mode);
                assertEq((map $1 ?? NULL, stamps), ds.select("select tz from copy_zone_check order by id").tz,
                    "instants preserved");
            }
            ds.commit();
        }
    }

    private invalidZones() {
        plain();
        foreach string zone in (("Bogus/Zone", "UTC'; drop table x; --", "Europe/../Prague", "/etc/localtime",
                "Europe/Prague ", "", "+01:75", "+01:00:30", "+1", "-0a:00")) {
            Datasource ds = plain();
            assertThrows("DBI:PGSQL:TIMEZONE-ERROR", sub () { ds.setOption("timezone", zone); ds.open(); },
                NOTHING, sprintf("%y", zone));
        }
        # an invalid value on an open connection leaves the declared and session zones unchanged
        string zone = differentZone(Regions);
        Datasource ds = withZone(zone); on_exit ds.close();
        assertThrows("DBI:PGSQL:TIMEZONE-ERROR", \ds.setOption(), ("timezone", "Bogus/Zone"));
        assertEq(zone, ds.getOption("timezone"));
        assertEq(zone, ds.selectRow("select pg_catalog.current_setting('TimeZone') as zone").zone);
        ds.commit();
    }
}
